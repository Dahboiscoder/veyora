# Copy this to apps/web/.env.local, apps/realtime/.env and packages/db/.env
# (the setup script / README explains why it's split three ways). Defaults
# below match docker-compose.yml exactly, so local dev works out of the box.

# --- Database ---
DATABASE_URL="postgresql://nyumba:nyumba_dev_password@localhost:5434/nyumba"

# --- Auth ---
# Generate real values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be IDENTICAL between apps/web and apps/realtime (realtime verifies
# tokens the web app signs). The app refuses to boot with these defaults
# when NODE_ENV=production.
JWT_ACCESS_SECRET="dev-insecure-access-secret-change-me"
JWT_REFRESH_SECRET="dev-insecure-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Object storage (MinIO locally; swap to S3/R2 in production by
# changing only these values) ---
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_BASE_URL="http://localhost:9000/media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="nyumba"
S3_SECRET_ACCESS_KEY="nyumba_dev_password"
S3_BUCKET="media"
S3_FORCE_PATH_STYLE="true"

# --- Realtime service ---
REALTIME_PORT=4001
REALTIME_INTERNAL_SECRET="dev-insecure-internal-secret-change-me"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"

# --- Public app config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# MapLibre style — no API key required. Swap for a Mapbox/MapTiler style +
# key for production-grade tiles/geocoding.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# --- Payments (optional — monetization features degrade gracefully without these) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
